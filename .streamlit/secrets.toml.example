# Copie este archivo a secrets.toml (local) o pegue su contenido en "Secrets" de Streamlit Cloud.
APP_PASSWORD = "clave-para-entrar"

# Neon (Postgres): sin esto el app guarda en SQLite, que en Streamlit Cloud se borra al reiniciar.
# DATABASE_URL = "postgresql://usuario:clave@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ID del Google Sheet de bancos (lo que va entre /d/ y /edit en el enlace)
SHEET_ID = "id-del-google-sheet"

# Opcional: para que el app escriba el asiento (04-N) en el Sheet al confirmar un lote.
# Cuenta de servicio de Google Cloud; compartir el Sheet con su client_email como Editor.
# [GOOGLE_SERVICE_ACCOUNT]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "pagos-ralumin@....iam.gserviceaccount.com"
# token_uri = "https://oauth2.googleapis.com/token"
